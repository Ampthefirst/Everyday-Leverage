      "options": [
        { "value": "grip", "label": "Can't grip it well", "hint": "it's too thin or small" },
        { "value": "noHold", "label": "Can't keep hold at all", "hint": "the hand can't close around it" },
        { "value": "turn", "label": "Can't turn it", "hint": "not enough twist" },
        { "value": "pull", "label": "Can't pull it", "hint": "too small to pinch" },
        { "value": "reach", "label": "Can't reach it", "hint": "too far or too low" },
        { "value": "slip", "label": "Hand slips off" },
        { "value": "press", "label": "Can't press hard enough or accurately" },
        { "value": "pain", "label": "It hurts or I'm injured" }
      ]
    },
    {
      "id": "hand",
      "text": "Which hand will you use?",
      "textOther": "Which hand will they use?",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" },
        { "value": "either", "label": "Either / both" }
