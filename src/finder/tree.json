      "options": [
        { "value": "jar", "label": "Jar or lid", "tasks": ["open", "turn"] },
        { "value": "bottle", "label": "Bottle cap", "tasks": ["open", "turn"] },
        { "value": "utensil", "label": "Spoon, fork or knife", "tasks": ["hold"] },
        { "value": "pen", "label": "Pen, pencil or brush", "tasks": ["hold"] },
        { "value": "toothbrush", "label": "Toothbrush or razor", "tasks": ["hold"] },
        { "value": "tool", "label": "Small tool (screwdriver, hex key)", "tasks": ["hold", "turn"] },
        { "value": "key", "label": "Key", "tasks": ["turn", "open"] },
        { "value": "knob", "label": "Round knob", "tasks": ["turn", "open", "pull"] },
        { "value": "tap", "label": "Tap or faucet", "tasks": ["turn", "open"] },
        { "value": "stove", "label": "Stove or oven knob", "tasks": ["turn"] },
        { "value": "drawer", "label": "Drawer or cupboard", "tasks": ["pull", "open"] },
        { "value": "door", "label": "Door lever", "tasks": ["reach", "open", "turn", "pull", "press"] },
        { "value": "zipper", "label": "Zipper or bag tab", "tasks": ["pull", "open"] },
        { "value": "can", "label": "Can ring-pull", "tasks": ["pull", "open"] },
        { "value": "button", "label": "Button or switch", "tasks": ["press", "reach"] },
        { "value": "screen", "label": "Phone or tablet screen", "tasks": ["press"] },
        { "value": "other", "label": "Something else", "tasks": ["open", "hold", "turn", "pull", "press", "reach"] }
      ]
    },
    {
      "id": "problem",
