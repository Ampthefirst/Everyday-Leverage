{
  "version": 1,
  "questions": [
    {
      "id": "task",
      "text": "What are you trying to do?",
      "textOther": "What are they trying to do?",
      "options": [
        { "value": "open", "label": "Open something", "hint": "a jar, a bottle" },
        { "value": "hold", "label": "Hold something", "hint": "a spoon, a pen, a tool" },
        { "value": "turn", "label": "Turn something", "hint": "a key, a knob, a tap" },
        { "value": "pull", "label": "Pull something", "hint": "a drawer, a zipper" },
        { "value": "press", "label": "Press something", "hint": "a button, a switch, a screen" },
        { "value": "reach", "label": "Reach or push a lever", "hint": "a door handle" },
        { "value": "body", "label": "Support my body", "hint": "standing up, walking, lifting myself" }
      ]
    },
    {
      "id": "object",
      "text": "What is the object?",
